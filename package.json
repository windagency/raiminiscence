{
  "name": "raiminiscence",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "rAIminiscence monorepo: an MCP server, agent hooks and CLIs giving an AI coding agent persistent memory",
  "license": "MIT",
  "author": "Damien TIVELET <damien@wind-agency.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/windagency/raiminiscence.git"
  },
  "homepage": "https://github.com/windagency/raiminiscence#readme",
  "bugs": {
    "url": "https://github.com/windagency/raiminiscence/issues"
  },
  "engines": {
    "node": ">=22.14.0"
  },
  "volta": {
    "node": "26.9.0"
  },
  "packageManager": "pnpm@12.15.0",
  "scripts": {
    "build": "pnpm -r build",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "typecheck": "pnpm -r typecheck && tsc -p tsconfig.json",
    "lint": "eslint .",
    "lint:duplication": "jscpd packages/*/src --reporters console --min-lines 5 --min-tokens 50",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "codemap": "tsx scripts/build-codemap.ts",
    "prepare": "husky",
    "backlinks:generate": "node scripts/generate-back-links.mjs",
    "backlinks:check": "node scripts/generate-back-links.mjs --check",
    "licenses:generate": "node scripts/generate-third-party-licenses.mjs",
    "licenses:check": "node scripts/generate-third-party-licenses.mjs --check",
    "release": "semantic-release",
    "readme:generate": "tsx scripts/generate-package-readme.ts",
    "readme:check": "tsx scripts/generate-package-readme.ts --check",
    "changelog:sync": "tsx scripts/changelog.ts sync",
    "changelog:check": "tsx scripts/changelog.ts sync --check"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@eslint-community/eslint-plugin-eslint-comments": "^4.8.1",
    "@eslint/js": "^10.0.1",
    "@opentelemetry/sdk-metrics": "^2.12.0",
    "@opentelemetry/sdk-trace-base": "^2.12.0",
    "@semantic-release/commit-analyzer": "^13.0.1",
    "@semantic-release/exec": "^7.1.0",
    "@semantic-release/git": "^11.0.1",
    "@semantic-release/github": "^12.0.10",
    "@vitest/coverage-v8": "^5.0.5",
    "arch-unit-ts": "^1.0.12",
    "conventional-changelog-conventionalcommits": "^9.3.1",
    "eslint": "^10.11.0",
    "eslint-plugin-check-file": "^3.3.2",
    "husky": "^9.1.7",
    "jscpd": "^5.4.0",
    "lint-staged": "^17.5.1",
    "prettier": "^3.9.8",
    "semantic-release": "^25.0.9",
    "ts-morph": "^28.0.0",
    "tsx": "^4.23.13",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.70.1",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
