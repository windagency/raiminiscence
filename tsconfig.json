{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "declaration": false
  },
  // Everything the per-package tsconfigs leave out: tests, architecture tests, benchmarks and repo
  // scripts. Vitest strips types without checking them, so this is the only type-check they get.
  // hippo-memory-runner is a separate npm project whose dependencies are installed on demand;
  // extended-compare.ts reaches its hippo-memory import through feedback-formula-runner.ts.
  "include": ["packages/*/test", "packages/*/__tests__", "__tests__", "benchmarks/**/*.ts", "scripts/*.ts", "vitest.config.ts"],
  "exclude": ["benchmarks/hippo-memory-runner", "benchmarks/extended-compare.ts"]
}
