{
  "name": "raiminiscence-mcp",
  "version": "1.0.1",
  "description": "Persistent memory for AI coding agents. A local MCP server for Claude Code, Cursor and Codex CLI that stores plain Markdown files and lets stale knowledge fade.",
  "keywords": [
    "mcp",
    "mcp-server",
    "model-context-protocol",
    "memory",
    "agent-memory",
    "long-term-memory",
    "ai-agents",
    "coding-agent",
    "claude-code",
    "cursor",
    "codex",
    "llm",
    "rag",
    "embeddings",
    "local-first"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./recall-client": {
      "types": "./dist/recall-client.d.ts",
      "default": "./dist/recall-client.js"
    }
  },
  "bin": {
    "raiminiscence-mcp": "./dist/server.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@huggingface/transformers": "^4.3.0",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@opentelemetry/api": "~1.9.1",
    "gray-matter": "^4.0.3",
    "pino": "^10.3.1",
    "ulid": "^3.0.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "typescript": "^5.6.3"
  },
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/windagency/raiminiscence.git",
    "directory": "packages/raiminiscence-mcp"
  },
  "homepage": "https://github.com/windagency/raiminiscence/tree/main/packages/raiminiscence-mcp#readme",
  "bugs": {
    "url": "https://github.com/windagency/raiminiscence/issues"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "imports": {
    "#src/*": {
      "source": "./src/*",
      "default": "./dist/*"
    }
  }
}
