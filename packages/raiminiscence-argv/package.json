{
  "name": "raiminiscence-argv",
  "version": "0.1.0",
  "description": "Small --name=value flag parsing and validation shared by the rAIminiscence CLIs.",
  "keywords": [
    "argv",
    "cli",
    "flags",
    "raiminiscence"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "typescript": "^5.6.3"
  },
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/windagency/raiminiscence.git",
    "directory": "packages/raiminiscence-argv"
  },
  "homepage": "https://github.com/windagency/raiminiscence/tree/main/packages/raiminiscence-argv#readme",
  "bugs": {
    "url": "https://github.com/windagency/raiminiscence/issues"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "imports": {
    "#src/*": {
      "source": "./src/*",
      "default": "./dist/*"
    }
  },
  "dependencies": {
    "zod": "^4.6.7"
  }
}
